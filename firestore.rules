rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return signedIn() ? request.auth.token.email.lower() : ''; }
    function isMainAdminEmail() { return signedIn() && myEmail() == 'similockdn@gmail.com'; }
    function myUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function myUserExists() { return signedIn() && exists(myUserPath()); }
    function myUser() { return get(myUserPath()).data; }
    function isAdmin() { return isMainAdminEmail() || (myUserExists() && myUser().role == 'Admin'); }
    function hasProfile() { return myUserExists() && myUser().role != 'Chưa phân quyền'; }
    function hasPerm(perm) { return isAdmin() || (hasProfile() && myUser().perms is list && myUser().perms.hasAny([perm])); }
    function canUpdateSaleCustomerInstall(oldSale, newSale) {
      return hasPerm('editSaleCustomerInstall')
        && newSale.diff(oldSale).affectedKeys().hasOnly([
          'customerId', 'customerCode', 'customerName', 'customerPhone',
          'customerAddress', 'customerType', 'customerGroup', 'customerSource',
          'customerSnapshot', 'customerEditHistory',
          'installStatus', 'installCompletedDate', 'techId', 'techName',
          'installNote', 'installEditHistory', 'updatedAt'
        ]);
    }
    function canUpdateSaleDebt(oldSale, newSale) {
      return hasPerm('debts')
        && newSale.diff(oldSale).affectedKeys().hasOnly([
          'paidTotal', 'debt', 'debtLeft', 'paymentStatus', 'status',
          'expectedSaleCommission', 'saleCommission', 'commissionEarnedAt',
          'commissionStatus', 'commissionHistory', 'updatedAt'
        ]);
    }
    function canUpdateSaleStockLink(oldSale, newSale) {
      return hasPerm('sales')
        && newSale.diff(oldSale).affectedKeys().hasOnly([
          'stockVoucherId', 'stockVoucherCode', 'orderStatus', 'updatedAt'
        ])
        && (!oldSale.keys().hasAny(['stockVoucherId']) || oldSale.stockVoucherId == '')
        && newSale.keys().hasAll(['stockVoucherId', 'stockVoucherCode', 'stockExported'])
        && newSale.stockVoucherId is string
        && newSale.stockVoucherId != ''
        && newSale.stockVoucherCode is string
        && newSale.stockVoucherCode != ''
        && newSale.stockExported == true;
    }
    function canCancelSale(oldSale, newSale) {
      return hasPerm('deleteSales')
        && newSale.diff(oldSale).affectedKeys().hasOnly([
          'canceled', 'isCanceled', 'status', 'paymentStatus', 'orderStatus',
          'commissionStatus', 'commissionEarnedAt', 'commissionHistory',
          'cancelReason', 'cancelledAt', 'cancelledBy', 'paidTotal',
          'debtLeft', 'updatedAt'
        ]);
    }
    function canRenameSaleWorkflow(oldSale, newSale) {
      return (hasPerm('categories') || hasPerm('system'))
        && newSale.diff(oldSale).affectedKeys().hasOnly([
          'installStatus', 'orderStatus', 'updatedAt'
        ]);
    }
    function canSyncSaleCustomerReference(oldDoc, newDoc) {
      return (hasPerm('editSaleCustomerInstall') || hasPerm('editSales'))
        && newDoc.diff(oldDoc).affectedKeys().hasOnly([
          'saleId', 'customerId', 'customerCode', 'customerName',
          'customerPhone', 'customerAddress', 'customerType', 'updatedAt'
        ]);
    }
    function isFixedWarehouseRole() {
      return myUserExists() && (myUser().role == 'Kho Chính' || myUser().role == 'Kho Văn Phòng');
    }
    function hasWarehouseAccess(warehouse) {
      return isAdmin() || (
        myUserExists()
        && (
          (myUser().role == 'Kho Chính' && warehouse == 'Kho Chính')
          || (myUser().role == 'Kho Văn Phòng' && warehouse == 'Kho Văn Phòng')
          || (
            !isFixedWarehouseRole()
            && myUser().keys().hasAny(['warehouseAccess'])
            && myUser().warehouseAccess is list
            && (
              myUser().warehouseAccess.hasAny([warehouse])
              || (myUser().role == 'Kho' && myUser().warehouseAccess.size() == 0)
            )
          )
        )
      );
    }
    function stockFromWarehouse(stock) {
      return stock.keys().hasAny(['fromWarehouse']) && stock.fromWarehouse != ''
        ? stock.fromWarehouse
        : (stock.keys().hasAny(['warehouse']) ? stock.warehouse : 'Kho Chính');
    }
    function stockWarehouse(stock) {
      return stock.keys().hasAny(['warehouse']) ? stock.warehouse : stockFromWarehouse(stock);
    }
    function stockToWarehouse(stock) {
      return stock.keys().hasAny(['toWarehouse']) ? stock.toWarehouse : '';
    }
    function stockInWarehouseScope(stock) {
      return hasWarehouseAccess(stockWarehouse(stock))
        || hasWarehouseAccess(stockFromWarehouse(stock))
        || hasWarehouseAccess(stockToWarehouse(stock));
    }
    function canReadStockVoucher(stock) {
      return isAdmin()
        || ((hasPerm('inventory') || hasPerm('stockbook')) && stockInWarehouseScope(stock))
        || ((hasPerm('sales') || hasPerm('reports')) && (!isFixedWarehouseRole() || stockInWarehouseScope(stock)));
    }
    function canWriteStockVoucher(stock) {
      return isAdmin()
        || ((hasPerm('inventory') || hasPerm('editStock')) && hasWarehouseAccess(stockFromWarehouse(stock)))
        || (hasPerm('sales') && (!isFixedWarehouseRole() || hasWarehouseAccess(stockFromWarehouse(stock))));
    }
    function validStockVoucherCreate(stock) {
      return (
          stock.type != 'TRANSFER'
          || (
            stock.keys().hasAll(['transferStatus', 'receivedItems', 'toWarehouse'])
            && stock.transferStatus == 'IN_TRANSIT'
            && stock.receivedItems is list
            && stock.receivedItems.size() == 0
            && stockToWarehouse(stock) != ''
            && stockToWarehouse(stock) != stockFromWarehouse(stock)
          )
        )
        && (
          stock.type != 'OUT'
          || (
            stock.keys().hasAll(['recipientType', 'recipientName'])
            && stock.recipientType is string
            && stock.recipientType != ''
            && stock.recipientName is string
            && stock.recipientName != ''
            && stockToWarehouse(stock) == ''
          )
        );
    }
    function canConfirmTransfer(oldStock, newStock) {
      return oldStock.keys().hasAny(['type'])
        && oldStock.type == 'TRANSFER'
        && oldStock.keys().hasAny(['transferStatus'])
        && oldStock.transferStatus == 'IN_TRANSIT'
        && newStock.keys().hasAny(['transferStatus'])
        && (newStock.transferStatus == 'RECEIVED' || newStock.transferStatus == 'RECEIVED_WITH_DIFFERENCE')
        && (hasPerm('inventory') || hasPerm('editStock'))
        && hasWarehouseAccess(stockToWarehouse(oldStock))
        && newStock.keys().hasAny(['receivedBy'])
        && newStock.receivedBy == myEmail()
        && oldStock.items is list
        && newStock.receivedItems is list
        && newStock.receivedItems.size() == oldStock.items.size()
        && newStock.diff(oldStock).affectedKeys().hasOnly([
          'transferStatus', 'receivedItems', 'receivedAt', 'receivedBy',
          'receiveNote', 'updatedAt'
        ]);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow create: if signedIn() && (
        (isMainAdminEmail() && uid == request.auth.uid && request.resource.data.role == 'Admin') ||
        (uid == request.auth.uid
          && request.resource.data.role == 'Chưa phân quyền'
          && request.resource.data.perms is list
          && request.resource.data.perms.size() == 0)
      );
      allow update: if signedIn() && (
        isAdmin() ||
        (uid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.perms == resource.data.perms
          && request.resource.data.warehouseAccess == resource.data.warehouseAccess)
      );
      allow delete: if isAdmin();
    }

    match /costPrices/{id} {
      allow read: if hasPerm('viewCost');
      allow write: if isAdmin();
    }

    match /salaries/{id} {
      allow read: if hasPerm('viewSalary') || hasPerm('manageSalary');
      allow write: if hasPerm('manageSalary');
    }

    match /customers/{id} {
      allow read: if hasProfile() || isAdmin();
      allow create, update: if hasPerm('customers') || hasPerm('sales') || hasPerm('debts');
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if hasProfile() || isAdmin();
      allow create, update: if hasPerm('products');
      allow delete: if isAdmin();
    }

    match /productCategories/{id} {
      allow read: if hasProfile() || isAdmin();
      allow write: if hasPerm('categories') || hasPerm('products');
    }

    match /systemCategories/{id} {
      allow read: if hasProfile() || isAdmin();
      allow write: if hasPerm('categories') || hasPerm('system');
    }

    match /warehouses/{id} {
      allow read: if hasProfile() || isAdmin();
      allow write: if isAdmin();
    }

    match /suppliers/{id} {
      allow read: if hasProfile() || isAdmin();
      allow write: if hasPerm('warehouseMaster') || hasPerm('categories') || hasPerm('system');
    }

    match /warrantyReasons/{id} {
      allow read: if hasProfile() || isAdmin();
      allow write: if hasPerm('categories') || hasPerm('warranty');
    }

    match /prices/{id} {
      allow read: if hasProfile() || isAdmin();
      allow create, update: if hasPerm('prices');
      allow delete: if isAdmin();
    }

    match /staff/{id} {
      allow read: if hasProfile() || isAdmin();
      allow write: if hasPerm('staff');
    }

    match /sales/{id} {
      allow read: if hasPerm('sales') || hasPerm('commissions') || hasPerm('debts') || hasPerm('reports') || hasPerm('warranty');
      allow create: if hasPerm('sales');
      allow update: if hasPerm('editSales')
        || canUpdateSaleCustomerInstall(resource.data, request.resource.data)
        || canUpdateSaleDebt(resource.data, request.resource.data)
        || canUpdateSaleStockLink(resource.data, request.resource.data)
        || canCancelSale(resource.data, request.resource.data)
        || canRenameSaleWorkflow(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /receipts/{id} {
      allow read: if hasPerm('sales') || hasPerm('commissions') || hasPerm('debts') || hasPerm('cashbook') || hasPerm('reports');
      allow create: if hasPerm('debts') || hasPerm('cashbook');
      allow update: if isAdmin() || canSyncSaleCustomerReference(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /stockVouchers/{id} {
      allow read: if canReadStockVoucher(resource.data);
      allow create: if canWriteStockVoucher(request.resource.data)
        && validStockVoucherCreate(request.resource.data);
      allow update: if isAdmin()
        || canSyncSaleCustomerReference(resource.data, request.resource.data)
        || (resource.data.type != 'TRANSFER'
          && canWriteStockVoucher(resource.data)
          && canWriteStockVoucher(request.resource.data))
        || canConfirmTransfer(resource.data, request.resource.data);
      allow delete: if (isAdmin() || (resource.data.type != 'TRANSFER' && hasPerm('deleteStock')))
        && canWriteStockVoucher(resource.data);
    }

    match /stockCounters/{id} {
      allow read: if hasPerm('inventory') || hasPerm('sales');
      allow create: if isAdmin();
      allow update: if (hasPerm('inventory') || hasPerm('sales'))
        && request.resource.data.prefix == resource.data.prefix
        && request.resource.data.value is int
        && request.resource.data.value > resource.data.value;
      allow delete: if isAdmin();
    }

    match /warranties/{id} {
      allow read: if hasPerm('warranty') || hasPerm('reports');
      allow create, update: if hasPerm('warranty');
      allow delete: if isAdmin();
    }

    match /expenses/{id} {
      allow read: if hasPerm('expenses') || hasPerm('cashbook') || hasPerm('reports');
      allow create, update: if hasPerm('expenses');
      allow delete: if isAdmin();
    }

    match /logs/{id} {
      allow create: if hasProfile() || isAdmin();
      allow read: if hasPerm('audit');
      allow update, delete: if isAdmin();
    }

    // Mặc định từ chối mọi collection chưa được khai báo phía trên.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
